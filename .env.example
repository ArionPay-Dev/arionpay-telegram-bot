# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
# ArionPay dashboard > your store
ARIONPAY_API_KEY=pk_...
ARIONPAY_API_SECRET=sk_...
# Keep true until everything works; test invoices take no real money
ARIONPAY_TEST_MODE=true
# Optional: a public https address of this bot (then ArionPay sends signed webhooks to PUBLIC_URL/arionpay/webhook).
# Leave empty to let the bot ask ArionPay about open orders every POLL_SECONDS instead (works anywhere).
PUBLIC_URL=
ARIONPAY_WEBHOOK_SECRET=
PORT=8080
POLL_SECONDS=30
SHOP_WELCOME=Welcome! Choose what you want to buy. You pay with Bitcoin, USDT and more.
